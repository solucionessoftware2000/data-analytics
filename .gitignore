# Data: the raw dataset is downloaded from Kaggle and every processed file
# is regenerated by running the notebooks (see data/README.md)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Jupyter
.ipynb_checkpoints/

# Office / Power BI temporary files
~$*

# Editor
.vscode/

# Operating system and OneDrive
Thumbs.db
desktop.ini
.DS_Store

# Power BI project: local settings and data cache
dashboard/**/.pbi/localSettings.json
dashboard/**/.pbi/cache.abf

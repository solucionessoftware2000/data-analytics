table churn_dataset
	lineageTag: 93bf49da-2090-47ef-8265-795553f7eba6

	measure 'Customers in cohort' = COUNTROWS ( churn_dataset )
		formatString: 0
		lineageTag: e223c37a-64d5-4ead-9cab-8db963a72bdc

	measure 'Return rate' = AVERAGE ( churn_dataset[returned] )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: fd522013-d8f0-4b05-9170-0ce167bfdc31

	measure 'Churn rate' = 1 - [Return rate]
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 4ee13888-33cc-463b-8c36-fd623643c84c

	measure 'Customers analyzed' = FORMAT ( [Customers in cohort], "#,0", "en-US" )
		lineageTag: 7550139f-fc1e-4bd6-b3da-2d5ab67c02cc

	measure 'Did not come back within 180 days' = FORMAT ( [Churn rate], "0.00%", "en-US" )
		lineageTag: c8ad2452-4860-44f2-ac3c-00b7005e73be


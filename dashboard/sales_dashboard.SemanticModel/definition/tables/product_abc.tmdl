table product_abc
	lineageTag: 3a17a52c-97b8-4d4f-bbf8-5fcc3358a4d3

	measure Products = DISTINCTCOUNT ( product_abc[product_id] )
		formatString: 0
		lineageTag: f476ac7b-4355-4d4c-ac9c-84d8ab971013

	measure 'Class A share of products' = DIVIDE ( CALCULATE ( [Products], product_abc[abc_class] = "A" ), [Products] )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 7090f8b7-e7a9-4f45-b981-062dff51dcb7

	measure 'Slow movers' = CALCULATE ( [Products], product_abc[is_slow_mover] = TRUE () )
		formatString: 0
		lineageTag: b360e5a1-ad30-4d57-94fc-9c6af0874c5d

	measure 'Products sold' = FORMAT ( [Products], "#,0", "en-US" )
		lineageTag: 94e6004c-34ff-4787-a8ff-ed41ac08d85f

	measure 'Class A products (80% of revenue)' = FORMAT ( [Class A share of products], "0.0%", "en-US" )
		lineageTag: acf3986f-2ba2-4e76-bf4a-7f83ad8fa955

	measure 'Slow-moving products' = FORMAT ( [Slow movers], "#,0", "en-US" )
		lineageTag: e769ee49-e035-4a86-8450-dd6f9d6535b6


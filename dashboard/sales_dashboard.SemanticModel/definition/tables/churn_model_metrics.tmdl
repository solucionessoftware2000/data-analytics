table churn_model_metrics
	lineageTag: 12af4a2a-60a8-40c9-b6ae-b72227400fc7

	measure 'Model ROC AUC (random forest)' = FORMAT ( CALCULATE ( MAX ( churn_model_metrics[roc_auc] ), churn_model_metrics[model] = "Random forest" ), "0.000", "en-US" )
		lineageTag: 799bf776-f4c7-4a0a-b552-bb3273fb21b4

	measure 'Returners found in the top 10%' = FORMAT ( CALCULATE ( MAX ( churn_model_metrics[top_10pct_capture] ), churn_model_metrics[model] = "Random forest" ), "0.0%", "en-US" )
		lineageTag: 969e5a61-2804-4e6e-87d5-2572cefc8261

